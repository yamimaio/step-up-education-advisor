# Copy to .env (`cp .env.example .env`) and fill in what you need. .env is never committed.
# Docker Compose reads .env twice: it passes every line to the web and dev containers, and it
# fills the ${...} in docker-compose.yml from it. A variable set in your shell wins over this file.
# After editing .env, recreate the container: docker compose up --build --force-recreate web

# --- Model ---

# Claude API key. Server-only: never commit it, log it or send it to the browser. Only
# server/model/anthropic.ts reads it. Left empty, the chat shows "The advisor isn't available
# right now" instead of crashing.
MODEL_API_KEY=

# Uncomment to serve persona A's scripted advisor (server/model/personaA.ts) instead of Claude:
# no key, no network, no spend. For local page work. While it is 1, MODEL_API_KEY is ignored.
# MODEL_FAKE=1

# --- Docker Compose ---

# Host port for the web or dev container. Default 3000; change it when another project holds 3000.
# HOST_PORT=3000

# User and group the dev container runs as. Default 0:0 (root), which is fine on Docker Desktop
# for macOS because it maps file ownership. On Linux, set them to the output of `id -u` and
# `id -g` so files the container writes into the repo stay yours (docker-compose.yml has the
# one-off chown for the volumes).
# UID=1000
# GID=1000
