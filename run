#!/bin/sh
# Runs a command in the dev container. Nothing but git, gh and docker runs on the host.
# Example: ./run npm test
# To reach a server started this way from the host, publish the port: ./run --ports npm run dev
if [ "$1" = "--ports" ]; then
  shift
  exec docker compose run --rm --service-ports dev "$@"
fi
exec docker compose run --rm dev "$@"
